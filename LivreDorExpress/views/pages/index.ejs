<%- include ('header') %>

    <div class="container ">
        <form class="mt-3" method="post" action="/">
            <div >
                <label class="form-label mb-3" for="message">message</label>
                <textarea name="message" id="message" class="form-control mb-3"></textarea>
            </div>
            <button class="bi bi-send btn btn-primary"> Envoyer</button>
        </form>
        
        <div class="container mt-3">
            <h3>Commentaires</h3>
            <% for (message of locals.allMessage) {%>
                <div class="d-flex mb-2">
                    <a class="bi bi-person fs-3" href="/message/<%=message.id%>"></a>
                    <div class="ms-2">
                        <div><%= message.created_at%></div>
                        <div><%= message.content %></div>
                    </div> 
                </div>
            <% } %>
        </div>
    </div>
    
<%- include ('footer') %>
